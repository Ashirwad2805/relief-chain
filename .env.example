# ==============================================================================
# ReliefChain Environment Configuration (example)
# Copy to .env and fill in values. Never commit real secrets.
# ==============================================================================

# Core Settings
SIMULATION_SEED=42
DATABASE_URL=sqlite:///./reliefchain.db
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me

# Browser-facing API URL (no quotes, no trailing slash).
# Local dev:   http://localhost:8000
# Production:  https://relief-chain-kain.onrender.com
VITE_API_URL=http://localhost:8000

# AI Chat (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free

# Optional Integration Keys
# MAPTILER_API_KEY=
# MAPBOX_TOKEN=
# GOOGLE_MAPS_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PAYMENT_TEST_KEY=
# BLOCKCHAIN_RPC_URL=
# BLOCKCHAIN_PRIVATE_KEY=
